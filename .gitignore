# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
uv.lock

# Project artifacts
songs/*/source.wav
songs/*/source.mp3
songs/*/source.m4a
outputs/
*.log

# Large media we don't want in git
*.wav
*.mp3
*.m4a
*.flac
*.mp4
*.mkv
*.mid
*.midi
!songs/*/score.mid
!songs/*/omr_seed/*.mid

# Background images may stay (small)
!songs/*/background.png

# Override JSON stays tracked (the user's own ruby corrections, not copyrighted)
!overrides/*.json

# Copyrighted song lyrics live in the private karaoke-jp-gold repo (lyrics/).
# Kept on disk locally as alignment ground truth, but untracked here.
songs/*/lyrics.txt

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Snakemake
.snakemake/

# UltraSinger benchmark raw outputs (UltraStar txt/mid/cache/cover per song) and
# resampled audio — regenerable, large; only the derived pred/morae/results JSON
# and the scripts are tracked. See benchmarks/kiritan/RESULTS.md §UltraSinger.
benchmarks/kiritan/ultrasinger/out/
benchmarks/kiritan/ultrasinger/out_nokey/
benchmarks/kiritan/ultrasinger/nohup_nokey.out
benchmarks/kiritan/ultrasinger/batch_nokey.log
benchmarks/vocadito/out/
benchmarks/vocadito/out_nokey/
benchmarks/vocadito/*.wav
benchmarks/vocadito/nohup_batch.out
benchmarks/vocadito/nohup_nokey.out

# Third-party repos: cloned by setup script, not vendored.
third_party/*
!third_party/.gitkeep
!third_party/README.md

# tmp/ is scratch space (OMR crops, QA renders, ablation dumps) — never tracked.
# Note: tmp/aina-kakumei/ holds crops of copyrighted sheet music — must stay out of git.
tmp/

# gold/ is a private submodule (copyright-sensitive melody transcriptions);
# its contents live in the private karaoke-jp-gold repo, not here.

# Copyrighted-background figures (overlaid on album art / MV / anime frames) —
# backed up in the private karaoke-jp-gold repo (figures/), untracked here.
# Only pure-background / original figures stay tracked.
figures/tuki-zero_with_bg.png
figures/chidori_gameplay.png
figures/chidori_cover.png
figures/night-dancer_cover.png
figures/bocchi-guitar_with_bg.png
figures/bocchi-guitar_frame.png

# Internal lab-notebook docs kept private (decision history / negative-results
# ledger / agent-collab state). Full copies live in the private karaoke-jp-gold
# repo (docs/); kept on disk locally but never public.
MEMORY.md
AGENTS.md

# SOFA checkpoints (2.2GB, re-downloadable: github.com/colstone/SOFA_Models JPN-V0.0.2b)
benchmarks/sofa_models/

# Benchmark third-party clones + heavyweight derived data (re-clone / re-derive, never vendor)
benchmarks/CTC_CE_for_AST/
benchmarks/ROSVOT/
benchmarks/SOFA/
benchmarks/jamendolyrics/
benchmarks/retrain/
benchmarks/*/rosvot_out/

# Presentation deck — separate sub-project, kept out of this repo
decks/

# Benchmark intermediate alignment dumps (re-derivable from RESULTS.md recipe)
benchmarks/**/mms_fa_htk/
benchmarks/**/sofa_segments/
benchmarks/**/*.lab
benchmarks/**/rosvot_pred.json

# Claude Code local runtime
.claude/scheduled_tasks.lock

# romaji.txt is the romanized answer-key of the same copyrighted lyrics, and
# backing.json quotes verbatim 〈…〉 echo lines — same privacy class as
# lyrics.txt: local + private repo only. (night-dancer/romaji.txt predates
# this rule; scheduled for the Tier-2 history cleanup.)
songs/*/romaji.txt
songs/*/backing.json

# Whale's background is the copyrighted album art (user-supplied) — the
# !background.png allowance is only for original / pure-background images.
songs/whale/background.png

# Alignment line-gold TSVs carry full lyric text — private-repo class.
# Canonical copies: karaoke-jp-gold/alignment_gold/ (restore with
# `cp gold/alignment_gold/*.gold.tsv data/alignment_gold/`).
data/alignment_gold/*.gold.tsv
